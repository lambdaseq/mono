{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}
 :aliases
 {:new {:extra-deps {io.github.seancorfield/deps-new
                     {:git/tag "v0.10.3" :git/sha "2c012c42185f9f14448f561481e6b39088e0fc82"}}
        :exec-fn org.corfield.new/create}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.seancorfield/deps-new
                      {:git/tag "v0.10.3" :git/sha "2c012c42185f9f14448f561481e6b39088e0fc82"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "test"]}
  :integration {:extra-paths ["integration" "test"]
                :extra-deps {io.github.seancorfield/deps-new
                             {:git/tag "v0.10.3" :git/sha "2c012c42185f9f14448f561481e6b39088e0fc82"}
                             io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                :main-opts ["-m" "cognitect.test-runner" "-d" "integration"]}
  :build {:extra-paths ["."]
          :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.11"}}
          :ns-default build}}}
