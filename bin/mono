#!/usr/bin/env bb
(require '[babashka.classpath :as cp] '[clojure.java.io :as io])
(let [root (.getParentFile (.getParentFile (.getCanonicalFile (io/file *file*))))]
  (cp/add-classpath (str (io/file root "src")))
  (cp/add-classpath (str (io/file root "resources"))))
(apply (requiring-resolve 'mono.cli/-main) *command-line-args*)
